{
  "name": "community-platform-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test:client": "node --test \"../tests/*-client.test.mjs\"",
    "test:unit": "node --test --test-concurrency=1 \"../tests/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"../tests/e2e/*.test.mjs\""
  },
  "dependencies": {
    "@hookform/resolvers": "https://registry.npmjs.org/@hookform/resolvers/-/resolvers-3.10.0.tgz",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-scroll-area": "1.2.3",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-tooltip": "1.1.8",
    "@tanstack/query-core": "https://registry.npmjs.org/@tanstack/query-core/-/query-core-5.90.19.tgz",
    "@tanstack/react-query": "https://registry.npmjs.org/@tanstack/react-query/-/react-query-5.90.19.tgz",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hast-util-to-text": "4.0.2",
    "katex": "0.19.0",
    "lucide-react": "0.541.0",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "https://registry.npmjs.org/react-hook-form/-/react-hook-form-7.68.0.tgz",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "zod": "3.25.76"
  },
  "overrides": {
    "rehype-katex": {
      "katex": "$katex"
    },
    "micromark-extension-math": {
      "katex": "$katex"
    }
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "esbuild": "https://registry.npmjs.org/esbuild/-/esbuild-0.27.7.tgz",
    "playwright": "1.60.0",
    "typescript": "5.9.3"
  }
