    "lucide-react": "0.541.0",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "https://registry.npmjs.org/react-hook-form/-/react-hook-form-7.68.0.tgz",
    "zod": "3.25.76"
