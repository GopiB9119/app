{
  "version": 1,
  "font": {
    "family": "Source Sans 3",
    "webFamily": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "source": "https://github.com/adobe-fonts/source-sans",
    "license": "licenses/SourceSans3-LICENSE.md",
    "letterSpacing": 0
  },
  "color": {
    "ink": "#1c1c1e",
    "muted": "#636366",
    "primary": "#0068d6",
    "primaryHover": "#005aba",
    "primarySurface": "#e8f1ff",
    "background": "#f2f2f7",
    "surface": "#ffffff",
    "border": "#e5e5ea",
    "controlBorder": "#86868b",
    "placeholder": "#6e6e73",
    "accent": "#b84900",
    "danger": "#d60012",
    "dangerSurface": "#ffeceb",
    "warningSurface": "#fff4d6",
    "success": "#1f7a39",
    "successSurface": "#e7f6ec",
    "fill": "#e9e9ee"
