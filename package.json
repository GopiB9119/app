{
  "name": "community-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Public community and private coordination, built one verified feature at a time.",
  "scripts": {
    "test:structure": "node --test scripts/feature-catalog.test.mjs",
    "structure": "node scripts/feature-catalog.mjs --materialize",
    "check:structure": "node scripts/feature-catalog.mjs --check",
    "tokens": "node scripts/design-tokens.mjs",
    "check:tokens": "node scripts/design-tokens.mjs --check",
    "test:tokens": "node --test scripts/design-tokens.test.mjs",
    "check:records": "node scripts/records-check.mjs",
    "test:records": "node --test scripts/records-check.test.mjs",
    "check:openapi": "node scripts/check-openapi.mjs",
    "test:openapi": "docker compose -f infra/compose.yaml --profile test run --rm --pull never tests pytest -q --tb=short -p no:cacheprovider tests/test_openapi.py",
    "golden": "node scripts/agent-golden.mjs",
    "test:golden": "node --test scripts/agent-golden.test.mjs",
    "work:cycle": "node scripts/work-cycle.mjs",
    "test:work-cycle": "node --test scripts/work-cycle.test.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "engines": { "node": ">=22" }
}